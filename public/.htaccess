<IfModule mod_rewrite.c>
  RewriteEngine On

  # Serve files and directories from the build as-is.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Missing build assets must not be answered with index.html.
  RewriteRule ^assets/ - [R=404,L]

  # Let React Router handle application routes.
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Always fetch the entry document again so it references the deployed bundle.
  <Files "index.html">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </Files>

  # Hashed Vite assets can be cached safely.
  <FilesMatch "\.(js|css|png|jpe?g|gif|svg|webp|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
